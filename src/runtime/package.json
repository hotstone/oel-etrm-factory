{
  "name": "etrm-factory-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "AgentCore Runtime service: Strands graph orchestrating the Linear ticket-to-PR pipeline.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/local.ts",
    "eval": "tsx src/eval-runner.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.0.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1115.0",
    "@aws-sdk/client-codebuild": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sts": "^3.1115.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "^0.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@strands-agents/sdk": "^1.0.0",
    "bedrock-agentcore": "^0.4.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
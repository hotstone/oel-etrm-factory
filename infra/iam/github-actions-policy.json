{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EvalInvokeRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-2:007460876082:runtime/etrm_factory_pipeline-WNJDR0HSAQ*"
    },
    {
      "Sid": "EvalSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-2:007460876082:secret:prod/linear/apikey-*",
        "arn:aws:secretsmanager:ap-southeast-2:007460876082:secret:prod/github/pat-*"
      ]
    },
    {
      "Sid": "EcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeRepositories"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-2:007460876082:repository/etrm-factory-runtime",
        "arn:aws:ecr:ap-southeast-2:007460876082:repository/etrm-factory-codebuild"
      ]
    },
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "RuntimeDeploy",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListAgentRuntimes",
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:UpdateAgentRuntime"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RolesMaintainedByDeployScripts",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:PutRolePolicy"],
      "Resource": [
        "arn:aws:iam::007460876082:role/etrm-factory-runtime-role",
        "arn:aws:iam::007460876082:role/claude-code-executor-role",
        "arn:aws:iam::007460876082:role/etrm-factory-trigger-role",
        "arn:aws:iam::007460876082:role/etrm-agent-bedrock-only"
      ]
    },
    {
      "Sid": "PassRolesToServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::007460876082:role/etrm-factory-runtime-role",
        "arn:aws:iam::007460876082:role/claude-code-executor-role",
        "arn:aws:iam::007460876082:role/etrm-factory-trigger-role"
      ]
    },
    {
      "Sid": "TriggerDeploy",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunctionUrlConfig"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-2:007460876082:function:etrm-factory-trigger"
    },
    {
      "Sid": "TriggerDeployTable",
      "Effect": "Allow",
      "Action": "dynamodb:DescribeTable",
      "Resource": "arn:aws:dynamodb:ap-southeast-2:007460876082:table/etrm-factory-runs"
    },
    {
      "Sid": "CodebuildProjectDeploy",
      "Effect": "Allow",
      "Action": ["codebuild:BatchGetProjects", "codebuild:UpdateProject"],
      "Resource": "arn:aws:codebuild:ap-southeast-2:007460876082:project/claude-code-executor"
    },
    {
      "Sid": "ArtifactsBucketHead",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::etrmfactory-agent-artifacts-007460876082"
    }
  ]
}

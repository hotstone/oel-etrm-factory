{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-2:007460876082:runtime/etrm_factory_pipeline-WNJDR0HSAQ*"
    },
    {
      "Sid": "WebhookSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-2:007460876082:secret:prod/linear/webhook-secret-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-2:007460876082:log-group:/aws/lambda/etrm-factory-trigger*"
    }
  ]
}
